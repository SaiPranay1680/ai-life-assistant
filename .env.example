# Copy to `.env` in the repo root before `docker compose up --build`.
# Never commit `.env`. Change passwords and JWT_SECRET before any shared/STG use.

POSTGRES_DB=ai_life_assistant
POSTGRES_USER=ai_app
POSTGRES_PASSWORD=change_me

# Used inside containers (Docker DNS names postgres / redis).
DATABASE_URL=postgresql+asyncpg://ai_app:change_me@postgres:5432/ai_life_assistant
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Browser origin for CORS. The browser runs on the host, not inside the Docker network.
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change_me_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
QUARANTINE_DIR=/data/quarantine
QUARANTINE_TTL_SECONDS=3600

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
CLAMAV_TIMEOUT_SECONDS=30

# Baked into the Next.js client bundle. Must be the URL the *browser* can reach.
NEXT_PUBLIC_API_URL=http://localhost:8000
