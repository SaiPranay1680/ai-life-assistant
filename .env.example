# Copy to `.env` in the repo root before `docker compose up --build`.
# Never commit `.env`. Change passwords and JWT_SECRET before any shared/STG use.

POSTGRES_DB=ai_life_assistant
POSTGRES_USER=ai_app
POSTGRES_PASSWORD=1627

# Used inside containers (Docker DNS names postgres / redis).
DATABASE_URL=postgresql+asyncpg://ai_app:1627@host.docker.internal:5432/ai_life_assistant
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Browser origin for CORS. The browser runs on the host, not inside the Docker network.
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change_me_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
QUARANTINE_DIR=/data/quarantine
QUARANTINE_TTL_SECONDS=3600

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
CLAMAV_TIMEOUT_SECONDS=30

# Baked into the Next.js client bundle. Must be the URL the *browser* can reach.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Google SMTP only. Never use NEXT_PUBLIC_* for these values.
# Create a 16-character Gmail App Password and put it in local `.env` (not git).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mail
SMTP_PASSWORD=paswword
SMTP_FROM_EMAIL=mail
SMTP_FROM_NAME=AI Life Assistant

OTP_EXPIRY_MINUTES=2
OTP_MAX_ATTEMPTS=25
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_LIMIT=25
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_VERIFY_LIMIT=10
OTP_VERIFY_WINDOW_SECONDS=900
PASSWORD_RESET_TOKEN_MINUTES=10

