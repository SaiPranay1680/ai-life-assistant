DATABASE_URL=postgresql+asyncpg://ai_app:1627@localhost:5432/ai_life_assistant
FRONTEND_URL=http://localhost:3000
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deferred (Phase 8-9 OIDC). Do not uncomment these while email/password JWT is active:
# they override JWT_ALGORITHM / ACCESS_TOKEN_EXPIRE_MINUTES and will break login.
# OIDC_CLIENT_ID=REPLACE_CLIENT_ID
# OIDC_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage: local for laptop/staging disk, s3 for live. Do not put real AWS keys in git.
STORAGE_BACKEND=local
# QUARANTINE_DIR=
# UPLOAD_DIR=
QUARANTINE_TTL_SECONDS=3600

# Live only. Prefer an IAM role instead of long-lived keys.
# STORAGE_BACKEND=s3
# AWS_REGION=ap-south-1
# AWS_S3_QUARANTINE_BUCKET=myapp-quarantine
# AWS_S3_PERMANENT_BUCKET=myapp-uploads
# AWS_S3_QUARANTINE_PREFIX=
# AWS_S3_PERMANENT_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local laptop: false (heuristic checks still run). Staging/live: true and run ClamAV.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
# Upload limits. Images are smaller so this cannot become a photo gallery.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=30
MAX_WORKSPACE_DOCUMENTS=50
MAX_WORKSPACE_BYTES=524288000

# Server-side Google SMTP. Placeholders only — never commit a real App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Life Assistant

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_VERIFY_LIMIT=10
OTP_VERIFY_WINDOW_SECONDS=900
PASSWORD_RESET_TOKEN_MINUTES=10
